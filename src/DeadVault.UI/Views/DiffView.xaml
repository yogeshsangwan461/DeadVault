<UserControl x:Class="DeadVault.UI.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBg}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Name="DiffHeaderText" Text="Diff Viewer" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Left"/>
                <Button Content="Back to Timeline" Style="{StaticResource SmallButton}"
                        DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Click="BackToTimeline_Click"/>
            </DockPanel>
            <TextBlock Name="DiffInfoText" FontSize="12"
                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Changed Files List -->
            <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="8"
                    Padding="12" Margin="0,0,0,12">
                <ListView Name="FilesList" Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextPrimary}"
                          SelectionChanged="FilesList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Status" Width="70"
                                            DisplayMemberBinding="{Binding KindSymbol}"/>
                            <GridViewColumn Header="File" Width="450"
                                            DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="Author" Width="90"
                                            DisplayMemberBinding="{Binding AuthorKind}"/>
                            <GridViewColumn Header="+Lines" Width="70"
                                            DisplayMemberBinding="{Binding LinesAdded}"/>
                            <GridViewColumn Header="-Lines" Width="70"
                                            DisplayMemberBinding="{Binding LinesRemoved}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Diff Text -->
            <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12">
                <RichTextBox Name="DiffTextBox" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto">
                    <RichTextBox.Document>
                        <FlowDocument PageWidth="5000"/>
                    </RichTextBox.Document>
                </RichTextBox>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
