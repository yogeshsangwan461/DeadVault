<UserControl x:Class="DeadVault.UI.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBg}">
    <DockPanel Margin="24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="Projects" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Left"/>
                <Button Content="+ Add Project" Style="{StaticResource AccentButton}"
                        Click="AddProject_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBlock Text="Manage your versioned project folders" FontSize="13"
                       Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Project List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ProjectsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBg}" CornerRadius="8"
                                Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding FolderPath}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Background="#22C55E" CornerRadius="4" Padding="8,3"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Watching" FontSize="11" Foreground="#000000" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Create Version" Style="{StaticResource SmallButton}"
                                            Margin="0,0,6,0" Tag="{Binding Id}"
                                            Click="SnapshotNow_Click"/>
                                    <Button Content="Timeline" Style="{StaticResource SmallButton}"
                                            Margin="0,0,6,0" Tag="{Binding Id}"
                                            Click="OpenTimeline_Click"/>
                                    <Button Content="Open Folder" Style="{StaticResource SmallButton}"
                                            Margin="0,0,6,0" Tag="{Binding FolderPath}"
                                            Click="OpenFolder_Click"/>
                                    <Button Content="Remove" Style="{StaticResource DangerButton}"
                                            Tag="{Binding Id}"
                                            Click="RemoveProject_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
