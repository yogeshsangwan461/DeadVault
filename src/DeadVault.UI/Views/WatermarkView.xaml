<UserControl x:Class="DeadVault.UI.Views.WatermarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBg}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Text &amp; Code Watermarking" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Proof-of-concept tools for marking and detecting provenance in pasted text/code."
                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Text / Docs">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Input text" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBox Name="TextInputBox" Height="170" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#333333" Padding="10"
                                     FontFamily="Consolas"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Ownership UID:" Width="120"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox Name="TextUidBox" Width="220" Padding="8,4"
                                         Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="1" BorderBrush="#333333"/>
                                <Button Content="Generate" Style="{StaticResource SmallButton}"
                                        Margin="10,0,0,0" Click="GenerateTextUid_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Embed Mark" Style="{StaticResource AccentButton}"
                                        Click="EmbedText_Click"/>
                                <Button Content="Detect / Extract" Style="{StaticResource SmallButton}"
                                        Margin="10,0,0,0" Click="DetectText_Click"/>
                            </StackPanel>

                            <TextBlock Name="TextStatusText" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" Margin="0,10,0,0"/>

                            <TextBlock Text="Output" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,6"/>
                            <TextBox Name="TextOutputBox" Height="170" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#333333" Padding="10"
                                     FontFamily="Consolas" IsReadOnly="True"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="AI Code Mark">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="260">
                                    <TextBlock Text="AI model" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox Name="AiModelSelector" SelectedIndex="0"
                                              Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}">
                                        <ComboBoxItem Content="GPT-5.4" Tag="gpt-5.4"/>
                                        <ComboBoxItem Content="GPT-4.1" Tag="gpt-4.1"/>
                                        <ComboBoxItem Content="Claude 3.7" Tag="claude-3.7"/>
                                        <ComboBoxItem Content="Claude 3.5 Sonnet" Tag="claude-3.5-sonnet"/>
                                        <ComboBoxItem Content="Gemini 2.5" Tag="gemini-2.5"/>
                                        <ComboBoxItem Content="GitHub Copilot" Tag="copilot"/>
                                        <ComboBoxItem Content="Cursor" Tag="cursor"/>
                                        <ComboBoxItem Content="Other / Unknown" Tag="unknown-ai"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Width="220" Margin="16,0,0,0">
                                    <TextBlock Text="Language" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox Name="LanguageSelector" SelectedIndex="0"
                                              Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}">
                                        <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                                        <ComboBoxItem Content="C#" Tag="csharp"/>
                                        <ComboBoxItem Content="Python" Tag="python"/>
                                        <ComboBoxItem Content="JavaScript" Tag="javascript"/>
                                        <ComboBoxItem Content="TypeScript" Tag="typescript"/>
                                        <ComboBoxItem Content="Rust" Tag="rust"/>
                                        <ComboBoxItem Content="Go" Tag="go"/>
                                        <ComboBoxItem Content="Java" Tag="java"/>
                                        <ComboBoxItem Content="C/C++" Tag="cpp"/>
                                        <ComboBoxItem Content="SQL" Tag="sql"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="UID (optional):" Width="120"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox Name="CodeUidBox" Width="220" Padding="8,4"
                                         Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="1" BorderBrush="#333333"/>
                                <Button Content="Generate" Style="{StaticResource SmallButton}"
                                        Margin="10,0,0,0" Click="GenerateCodeUid_Click"/>
                            </StackPanel>

                            <TextBlock Text="AI-generated code" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,6"/>
                            <TextBox Name="CodeInputBox" Height="240" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#333333" Padding="10"
                                     FontFamily="Consolas"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Mark Code" Style="{StaticResource AccentButton}"
                                        Click="MarkCode_Click"/>
                                <Button Content="Detect / Extract" Style="{StaticResource SmallButton}"
                                        Margin="10,0,0,0" Click="DetectCodeFromMarkTab_Click"/>
                            </StackPanel>

                            <TextBlock Name="CodeStatusText" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" Margin="0,10,0,0"/>

                            <TextBlock Text="Output" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,6"/>
                            <TextBox Name="CodeOutputBox" Height="220" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#333333" Padding="10"
                                     FontFamily="Consolas" IsReadOnly="True"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="AI Code Detect">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Paste code to detect" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBox Name="CodeDetectInputBox" Height="280" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#333333" Padding="10"
                                     FontFamily="Consolas"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Detect / Extract" Style="{StaticResource AccentButton}"
                                        Click="DetectCode_Click"/>
                            </StackPanel>

                            <TextBlock Name="CodeDetectStatusText" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Detect AI Text">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Paste text to detect" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBox Name="AiTextDetectInputBox" Height="240" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#333333" Padding="10"
                                     FontFamily="Consolas"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Detect / Extract" Style="{StaticResource AccentButton}"
                                        Click="DetectAiText_Click"/>
                            </StackPanel>

                            <TextBlock Name="AiTextDetectStatusText" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</UserControl>

