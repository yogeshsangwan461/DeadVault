<UserControl x:Class="DeadVault.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>

            <!-- Project Selector -->
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Select Project" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <ComboBox Name="ProjectSelector" Width="400" HorizontalAlignment="Left"
                              SelectionChanged="ProjectSelector_Changed"/>
                </StackPanel>
            </Border>

            <!-- Exclusion Rules -->
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Exclusion Rules" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <TextBlock Text="Files matching these patterns will NOT be included in versions."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>

                    <ListBox Name="ExclusionsList" MaxHeight="250"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,2">
                                    <Button Content="X" DockPanel.Dock="Right"
                                            Style="{StaticResource DangerButton}"
                                            Tag="{Binding Pattern}" Click="RemoveExclusion_Click"
                                            FontSize="10" Padding="6,2" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Pattern}" FontFamily="Consolas"
                                               FontSize="13" Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Name="NewPatternBox" Width="300" Padding="8,6"
                                 Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="1" BorderBrush="#333333" FontFamily="Consolas"/>
                        <Button Content="Add Pattern" Style="{StaticResource SmallButton}"
                                Margin="8,0,0,0" Click="AddExclusion_Click"/>
                    </StackPanel>

                    <Button Content="Apply Exclusions &amp; Update .gitignore"
                            Style="{StaticResource AccentButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="ApplyExclusions_Click"/>
                </StackPanel>
            </Border>

            <!-- Debounce Setting -->
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Auto-Version Delay" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="How long to wait after you stop editing before creating a version"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

                    <CheckBox Name="DisableAutoVersioningCheck"
                              Content="Disable auto-versioning (infinite delay)"
                              Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Name="DebounceSlider" Width="300" Minimum="1" Maximum="600"
                                Value="60" TickFrequency="15" IsSnapToTickEnabled="True"/>
                        <TextBox Name="DebounceSecondsBox" Width="90" Margin="12,0,0,0" Padding="8,4"
                                 Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="1" BorderBrush="#333333"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="s" Margin="8,0,0,0"
                                   FontSize="14" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Tip: enter a larger number for long delays, or disable for infinity."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                    <Button Content="Save Debounce" Style="{StaticResource SmallButton}"
                            Margin="0,8,0,0" HorizontalAlignment="Left"
                            Click="SaveDebounce_Click"/>
                </StackPanel>
            </Border>

            <!-- Attribution -->
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MCP Attribution" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="AI/model attribution is primarily supplied by MCP clients when they create versions. Local app snapshots default to Human."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                    <TextBlock Text="When an AI uses the MCP server, it should identify the client and model family so DeadVault can tag the snapshot automatically."
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Example MCP metadata: authorKind=ai, clientName=claude-desktop, modelFamily=claude, model=claude-3.7"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Borrowed from:" Width="120"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBox Name="WatermarkingSourceBox" Width="240" Padding="6,4"
                                 Background="#1A1A1A" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="1" BorderBrush="#333333"/>
                    </StackPanel>
                    <TextBlock Text="Example: DeadMark v0.1 (text/code watermarking UI + carriers)"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,10"/>

                    <CheckBox Name="EnableWatermarkingCheck"
                              Content="Enable deterministic attribution manifest"
                              Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Name="AttributionBudgetText"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"/>

                    <Button Content="Save MCP Attribution Settings" Style="{StaticResource SmallButton}"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Click="SaveAttribution_Click"/>
                </StackPanel>
            </Border>

            <!-- Agent Auto-Start -->
            <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Background Agent" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <TextBlock Name="StartupStatusText" Text="Checking..."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Register Startup Task" Style="{StaticResource AccentButton}"
                                Margin="0,0,10,0" Click="RegisterStartup_Click"/>
                        <Button Content="Remove Startup Task" Style="{StaticResource DangerButton}"
                                Click="UnregisterStartup_Click"/>
                    </StackPanel>
                    <Button Content="Start Agent Now" Style="{StaticResource SmallButton}"
                            Margin="0,10,0,0" HorizontalAlignment="Left"
                            Click="StartAgent_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
