<UserControl x:Class="DeadVault.UI.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBg}">
    <UserControl.Resources>
        <Style x:Key="TimelineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="8,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <Path HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="#CCCCCC"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="360">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimelineComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="ProjectNameText" Text="Timeline" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Border Name="CurrentVersionBadge" Background="#3B82F6" CornerRadius="6"
                                Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock Name="CurrentVersionText" FontSize="13" FontWeight="Bold"
                                       Foreground="#000000"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Name="ProjectPathText" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    <TextBlock Name="TimelineStatusText" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Name="RestoreSelector" Width="320" Margin="0,0,10,0"
                              Style="{StaticResource TimelineComboBoxStyle}"
                              ItemContainerStyle="{StaticResource TimelineComboBoxItemStyle}"
                              Background="{StaticResource CardBg}"
                              Foreground="#CCCCCC">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RestoreLabel}" Foreground="#CCCCCC"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Restore Selected" Style="{StaticResource SmallButton}"
                            Margin="0,0,10,0"
                            Click="RestoreSelected_Click"/>
                    <ComboBox Name="ProjectSelector" Width="220" Margin="0,0,10,0"
                              SelectionChanged="ProjectSelector_Changed"
                              Style="{StaticResource TimelineComboBoxStyle}"
                              ItemContainerStyle="{StaticResource TimelineComboBoxItemStyle}"
                              Background="{StaticResource CardBg}"
                              Foreground="#CCCCCC">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#CCCCCC"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Refresh" Style="{StaticResource SmallButton}" Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Empty State -->
        <StackPanel Name="EmptyState" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock Text="No versions yet" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="Edit files in your project folder and they'll be versioned automatically."
                       FontSize="13" Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Or click 'Create Version' on the Projects page to create one manually."
                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Snapshot List -->
        <ListBox Name="SnapshotsList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource TextPrimary}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBg}" CornerRadius="8"
                                Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- SHA -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ShortSha}" FontFamily="Consolas"
                                               FontSize="13" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Message}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding RelativeTime}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding HasFileCount, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text=" | " Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                            <TextBlock Text="{Binding FilesChangedLabel}"
                                                       FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>

                                        <!-- Version badge -->
                                        <Border Background="#3B82F6" CornerRadius="4"
                                                Padding="6,2" Margin="10,0,0,0"
                                                Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                       Foreground="#000000" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Bump kind badge -->
                                        <Border Background="{Binding BumpKindColor}" CornerRadius="4"
                                                Padding="6,2" Margin="4,0,0,0"
                                                Visibility="{Binding HasBumpKind, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding BumpKind}" FontSize="11"
                                                       Foreground="#000000" FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#FDE68A" CornerRadius="4"
                                                Padding="6,2" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding AuthorBadgeText}" FontSize="11"
                                                       Foreground="#000000" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Tag badge -->
                                        <Border Background="{StaticResource YellowBrush}" CornerRadius="4"
                                                Padding="6,2" Margin="10,0,0,0"
                                                Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding TagName}" FontSize="11"
                                                       Foreground="#000000" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Pre-restore badge -->
                                        <Border Background="{StaticResource PeachBrush}" CornerRadius="4"
                                                Padding="6,2" Margin="10,0,0,0"
                                                Visibility="{Binding IsPreRestore, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Pre-Restore" FontSize="11"
                                                       Foreground="#000000" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Restore" Style="{StaticResource SmallButton}"
                                            Margin="0,0,4,0" Tag="{Binding CommitSha}"
                                            Click="Restore_Click"/>
                                    <Button Content="Diff" Style="{StaticResource SmallButton}"
                                            Margin="0,0,4,0" Tag="{Binding CommitSha}"
                                            Click="Diff_Click"/>
                                    <Button Content="Tag" Style="{StaticResource SmallButton}"
                                            Margin="0,0,4,0" Tag="{Binding CommitSha}"
                                            Click="Tag_Click"/>
                                    <Button Content="Export" Style="{StaticResource SmallButton}"
                                            Tag="{Binding CommitSha}"
                                            Click="Export_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

