<Window x:Class="DeadVault.UI.Views.ExclusionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select File Exclusions" Width="500" Height="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#000000">

    <Border Padding="20">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="File Exclusions" FontSize="20" FontWeight="Bold"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="Uncheck patterns you want to include in versioning. These files will be ignored by DeadVault."
                           FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Name="FolderPathText" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Padding="20,8" Margin="0,0,10,0"
                        Background="#1A1A1A" Foreground="#FFFFFF" BorderThickness="1"
                        BorderBrush="#333333" Cursor="Hand" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Confirm" Padding="20,8"
                        Background="#3B82F6" Foreground="#000000" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="Confirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Add custom pattern -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox Name="CustomPatternBox" Width="340" Padding="8,6"
                         Background="#1A1A1A" Foreground="#FFFFFF" BorderThickness="1"
                         BorderBrush="#333333" FontFamily="Consolas" FontSize="13"/>
                <Button Content="+ Add" Padding="12,6" Margin="8,0,0,0"
                        Background="#1A1A1A" Foreground="#FFFFFF" BorderThickness="1"
                        BorderBrush="#333333" Cursor="Hand" Click="AddCustom_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Exclusion list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                <ItemsControl Name="ExclusionItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1A1A" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Pattern}" FontFamily="Consolas"
                                                   FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="#666666"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
